# Local development defaults to the in-memory demo.
VITE_USE_FAKE_API=true
VITE_FULLTANK_API_URL=/api/v1
# Each BC adds its public endpoint configuration in its own PR.
# Payment bounded context (demo endpoints served by the in-memory fake API).
VITE_PAYMENTS_ENDPOINT_PATH=/payments
VITE_INVOICES_ENDPOINT_PATH=/invoices
VITE_PAYMENT_CHECKOUT_ENDPOINT_PATH=/payment-checkout
